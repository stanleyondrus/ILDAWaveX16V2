   {
    "id": "ping-req-large-1600",
    "kind": "datagram",
    "direction": "client-to-server",
    "summary": "Legal ping request whose UDP payload (1604 octets) exceeds 1500",
    "refs": ["Hello 3.1 p8 (payload of arbitrary size)", "Hello 7 p32"],
    "interpretation": "project",
    "note": "Size limit is the transport's (UDP/IP reassembly); the 'no partial echo' rule is the plan 02 interpretation of Hello 3.1.1 'exact copy in content and length'.",
    "length": 1604,
    "segments": [
      {"offset": 0, "field": "hello.command", "hex": "08", "value": "0x08 ping request", "ref": "Hello 2.1 p5-6"},
      {"offset": 1, "field": "hello.flags", "hex": "00", "value": "client group 0", "ref": "Hello 2.1 p6-7"},
      {"offset": 2, "field": "hello.sequence", "hex": "0002", "value": "0x0002", "ref": "Hello 2.1 p7"},
      {"offset": 4, "field": "ping.payload", "hex": "", "value": "1600 octets, value = offset & 0xFF", "ref": "Hello 3.1 p8"}
    ],
    "expect": {
     "outcome": "respond",
     "response_length": 1604,
     "note": "receiver must echo all 1604 octets or nothing; a receive buffer shorter than the datagram must be detected as truncation, never echoed as complete"
    }
   },
